{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akode.com/schemas/docxgen/package-license-allowlist.schema.json",
  "title": "Akode.DocxGen resolved package license allow-list",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allowedLicenses",
    "packages"
  ],
  "properties": {
    "allowedLicenses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "license"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
