<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>docxgen</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>docxgen</ToolCommandName>
    <PackageId>Akode.DocxGen.Tool</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Cross-platform DocxGen CLI for deterministic DOCX generation, extraction, inspection, and validation.</Description>
    <PackageTags>$(PackageTags);cli;dotnet-tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Akode.DocxGen.Core\Akode.DocxGen.Core.csproj" />
    <ProjectReference Include="..\Akode.DocxGen.Docx\Akode.DocxGen.Docx.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
